[[module CSS]]
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Bamum:wght@400..700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400..700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Monsieur+La+Doulaise&display=swap');
@import url("https://fontsapi.zeoseven.com/240/main/result.css");
@import url("https://fontsapi.zeoseven.com/240/w40/result.css");
@import url("https://fontsapi.zeoseven.com/14/main/result.css");

:root {
    --main-logo: url("https://hormress.github.io/SCP/normal/scp-cn-2830/Enkan.svg");
    --banner-bg: url("https://hormress.github.io/SCP/normal/scp-cn-2830/Aurora.jpg");
    --banner-fg: url("https://hormress.github.io/SCP/normal/scp-cn-2830/Aurora.png");
    --header-logo-mask: none;
    --header-logo-right-margin: 0rem;

    --body-font: "Noto Sans SCS", "Inter", "Noto Sans SC", sans-serif;
    --jp-font: "Noto Sans SCS", "Inter", "Noto Sans JP", sans-serif;
    --latin-font: "Inter", "Noto Sans SC", sans-serif;

    --top-bar-link-color: var(--basalt-main-text-color);
    --header-color-one: var(--basalt-secondary-color);
    --header-color-two: var(--basalt-secondary-color);

    --set-safari-mode-disabled: set;

    --title-size: 1.25rem;
    --subtitle-size: 0rem;
    --user-button-width: 2.25rem;
    --side-bar-button-width: 2.25rem;
    --main-content-top-margin: 1.5rem;
    --main-content-width: 52rem;

    --basalt-undertone: 20, 152, 202;
 
    --basalt-bright-element-color: 20, 165, 227;
    --basalt-dark-element-color: 20, 124, 172;
    --basalt-darker-element-color: 50, 152, 171;

    --modal-fader-background-color: 20, 20, 20;

    --_size: 0.5rem;
    --_clip-path: polygon(var(--_size) -100%, -100% -100%, -100% 200%, 200% 200%, 200% -100%, calc(100% - var(--_size)) -100%, calc(100% - var(--_size)) var(--_size), 200% var(--_size), 200% calc(100% - var(--_size)), calc(100% - var(--_size)) calc(100% - var(--_size)), calc(100% - var(--_size)) 200%, var(--_size) 200%, var(--_size) calc(100% - var(--_size)), -100% calc(100% - var(--_size)), -100% var(--_size), var(--_size) var(--_size));
}

div#header h1 a span::after {
    margin-bottom: 0;
}

div#header {
    opacity: 0;
    pointer-events: none;
    background-image: none;
    background-color: rgb(var(--basalt-primary-color));
    box-shadow: unset;
    transition: opacity ease 0.25s;
}

#side-bar::before,
#side-bar::after {
    opacity: 0;
    pointer-events: none;
    transition: opacity ease 0.25s, height var(--side-bar-transition), background-color var(--side-bar-transition);
}

#login-status span.printuser > a,
#search-top-box-form input[type="submit"] {
    pointer-events: none;
}

:root:has(div.nav-switch):not(:has(div.nav-switch div.collapsible-block-unfolded[style*="none"])) div#header,
:root:has(div.nav-switch):not(:has(div.nav-switch div.collapsible-block-unfolded[style*="none"])) #side-bar::before,
:root:has(div.nav-switch):not(:has(div.nav-switch div.collapsible-block-unfolded[style*="none"])) #side-bar::after,
:root:has(div.nav-switch):not(:has(div.nav-switch div.collapsible-block-unfolded[style*="none"])) #login-status span.printuser > a,
:root:has(div.nav-switch):not(:has(div.nav-switch div.collapsible-block-unfolded[style*="none"])) #search-top-box-form input[type="submit"] {
    opacity: 1;
    pointer-events: auto;
}

div.nav-switch {
    position: fixed;
    top: calc(var(--header-final-height) + 0.25rem);
    right: 0.25rem;
    transition: top ease 0.125s;
    z-index: 1;
}

div.nav-switch a.collapsible-block-link {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    text-align: center;
    line-height: 1.75rem;
    font-weight: 900;
    font-family: var(--latin-font);
    transition: background-color ease 0.125s;
}

div.nav-switch a.collapsible-block-link:is(:hover, :focus) {
    background-color: rgb(var(--basalt-tertiary-color));
    text-decoration: none;
}

/* 页面布局 */

div#main-content {
    width: auto;
    max-width: 100%;
    margin: calc(-1 * var(--header-final-height)) 0 0;
    background-image: linear-gradient(
        to right,
        rgb(0, 0, 0),
        5%, transparent 20% 80%, 95%,
        rgb(0, 0, 0)
    );
}

div#page-title {
    display: none;
}

div#page-title,
div.meta-title {
    margin-top: 3rem;
    text-align: center;
    font-family: "Noto Serif SC", serif;
}

div#page-options-container,
div#action-area {
    width: var(--main-content-width);
    margin: 0 auto var(--main-content-bottom-margin);
    max-width: calc(100% - var(--main-content-side-margin) *2);
}

div#page-content,
div.credit {
    line-height: 1.75;
    text-align: justify;
    text-justify: inter-character;
    /* text-wrap: pretty; */
    justify-align: both;
}

div#page-content + div.page-tags {
    width: var(--main-content-width);
    margin: 0 auto;
}

div#page-info-break {
    height: 25dvh;
}

/* 页面内容元素 */

div#u-credit-view .modalbox > div.credit {
    margin: 0;
    padding: 0 1.25rem;
}

div#page-content div.rate-box {
    position: sticky;
    height: 2rem;
    width: max-content;
    margin-inline: auto 0.25rem;
    top: calc(100dvh - 2.25rem);
    align-content: end;
    z-index: 1;
}

div#page-content div.rate-box div.page-rate-widget-box {
    margin-block: 0;
}

iframe.music {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    filter: invert(1) hue-rotate(180deg);
    clip-path: polygon(10px 10px, calc(100% - 10px) 10px, calc(100% - 10px) calc(100% - 10px), 10px calc(100% - 10px));
    -webkit-clip-path: polygon(10px 10px, calc(100% - 10px) 10px, calc(100% - 10px) calc(100% - 10px), 10px calc(100% - 10px));
}

p:has(> iframe.music) {
    display: block;
    position: relative;
    width: max(80%, 16rem);
    height: 86px;
    margin: 0 auto;
}

p:has(> iframe.music)::before {
    content: "";
    display: block;
    position: absolute;
    left: 10px;
    top: 10px;
    width: 66px;
    height: 66px;
    backdrop-filter: invert(1) hue-rotate(180deg);
    pointer-events: none;
    z-index: 1;
}

div.normal-content {
    width: var(--main-content-width);
    max-width: calc(100% - var(--main-content-side-margin) * 2) !important;
    margin-inline: auto;
}

div.banner ~ div.normal-content:nth-of-type(1) {
    z-index: 2;
}

div.banner {
    position: relative;
    --_si: min(max(50dvw, 16rem), 50dvh);
    --_mask: linear-gradient(to bottom, black 0%, black calc(50dvh + var(--_si)), calc(50dvh + 1.65 * var(--_si)), transparent calc(50dvh + 2 * var(--_si)));
    height: calc(50dvh + 3 * var(--_si));
    margin-bottom: -50dvh;
    pointer-events: none;
    mask-image: var(--_mask);
    mask-size: cover;
    mask-repeat: no-repeat;
    mask-position: top;
    -webkit-mask-image: var(--_mask);
    -webkit-mask-size: cover;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: top;
    background-image: var(--banner-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: 1;
}

div.banner::after {
    content: "";
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    background-image: var(--banner-fg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

div.banner div.anchor {
    position: sticky;
    top: 50dvh;
}

div.banner div.anchor::before {
    content: "";
    display: block;
    position: absolute;
    left: 50%;
    top: 0%;
    width: 100%;
    height: max(100dvw, 32rem);
    transform: translate(-50%, -50%);
    background-image: var(--main-logo);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

div.banner div.anchor::after {
    content: "";
    display: block;
    position: absolute;
    left: 50%;
    top: 0%;
    width: 100%;
    height: 100dvh;
    transform: translate(-50%, -50%);
    background-image: radial-gradient(
        circle at center in hsl shorter hue,
        rgb(144, 72, 204, 0.2),
        rgb(20, 0, 204, 0.2),
        rgb(0, 24, 72, 0.4),
        rgb(20, 0, 0, 0.2),
        rgb(0, 0, 20, 0)
    );
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -1;
}

div.section {
    position: relative;
    width: max-content;
    margin: 5rem auto 0.5rem;
    padding: 0.8rem 1rem;
}

div.section.quad.i,
div.section.quad.ii {
    padding-top: 0.5rem;
}

div.section.quad.iii,
div.section.quad.iv {
    padding-bottom: 0.5rem;
}

div.section.quad::before {
    content: "";
    display: block;
    position: absolute;
    left: 0.25rem;
    top: 0;
    width: 0.1rem;
    height: 100%;
    background-image: linear-gradient(
        to top,
        rgb(var(--basalt-main-text-color), 0.8),
        80%,
        rgb(var(--basalt-main-text-color), 0)
    );
}

div.section.quad::after {
    content: "";
    display: block;
    position: absolute;
    bottom: 0.25rem;
    left: 0;
    height: 0.1rem;
    width: 100%;
    background-image: linear-gradient(
        to right,
        rgb(var(--basalt-main-text-color), 0.8),
        80%,
        rgb(var(--basalt-main-text-color), 0)
    );
}

div.section.quad.ii::before,
div.section.quad.iii::before {
    left: unset;
    right: 0.25rem;
}

div.section.quad.iii::before,
div.section.quad.iv::before {
    background-image: linear-gradient(
        to bottom,
        rgb(var(--basalt-main-text-color), 0.8),
        80%,
        rgb(var(--basalt-main-text-color), 0)
    );
}

div.section.quad.iii::after,
div.section.quad.iv::after {
    bottom: unset;
    top: 0.25rem;
}

div.section.quad.ii::after,
div.section.quad.iii::after {
    background-image: linear-gradient(
        to left,
        rgb(var(--basalt-main-text-color), 0.8),
        80%,
        rgb(var(--basalt-main-text-color), 0)
    );
}

div.section.rasen::before {
    content: "";
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border-inline: solid 0.1rem rgb(var(--basalt-main-text-color), 0.8);
    transform: translate(-50%, -50%) skewX(10deg) skewY(10deg);
    pointer-events: none;
    z-index: -1;
}

div.section.rasen::after {
    content: "";
    display: block;
    position: absolute;
    width: 50%;
    height: 75%;
    left: 50%;
    top: 50%;
    border-radius: 50%;
    border-inline: solid 0.1rem rgb(var(--basalt-main-text-color), 0.8);
    transform: translate(-50%, -50%) skewX(-45deg) skewY(-45deg);
    pointer-events: none;
    z-index: -1;
}

div.section h1,
div.subsection h1 {
    text-align: center;
    letter-spacing: 0.15em;
    font-family: "XiangcuiChaoxisongW15";
    font-weight: 400;
}

div.section h1::first-letter,
div.subsection h1::first-letter {
    margin-left: 0.075em;
}

div.section h1 {
    margin-block: 0;
    font-size: 2.25em;
}

div.section h2 {
    margin-block: 0;
    font-size: 1.25em;
    text-align: center;
    letter-spacing: 0.2em;
    font-family: "LXGW ZhiSong CL";
    font-weight: 400;
}

div.section h2::first-letter {
    margin-left: 0.1em;
}

div.subsection h1 {
    font-size: 1.5em;
}

div.blockquote.ac {
    position: relative;
}

div.blockquote.ac::before {
    content: "";
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0%;
    top: 0%;
    border: solid var(--thin-border-width) rgb(var(--basalt-dark-element-color));
    clip-path: var(--_clip-path);
    -webkit-clip-path: var(--_clip-path);
}

div.fin {
    position: relative;
    width: 0;
    height: 2.5rem;
    margin: 0 15rem 0.25rem auto;
    text-align: right;
}

div.fin p {
    position: absolute;
    width: max-content;
    left: 50%;
    top: 50%;
    font-size: 2.5em;
    font-family: "Monsieur La Doulaise";
    transform: translate(-50%, -50%);
    margin-block: 0;
}

/* TEST用 */

a.newpage {
