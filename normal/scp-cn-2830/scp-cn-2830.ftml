[[module CSS]]
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Bamum:wght@400..700&display=swap');

span.spin {
    display: inline-block;
    font-family: "Noto Sans Bamum";
    animation: spin 5s linear infinite;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}
[[/module]]

