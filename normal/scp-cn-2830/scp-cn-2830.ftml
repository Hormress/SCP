}

span.spin {
    display: inline-block;
    font-family: "Noto Sans Bamum";
    animation: spin 5s linear infinite;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}
