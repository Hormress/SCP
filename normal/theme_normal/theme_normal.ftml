    --header-title-color: var(--main-text-color);
    --header-subtitle-color: var(--main-text-color);
    --header-color-one: var(--basalt-primary-color);
    --header-color-two: var(--basalt-primary-color);
    --diagonal-stripes-color: var(--basalt-main-text-color);
    --diagonal-stripes-angle: 30deg;
    --diagonal-stripes-width: 0.2rem;
    --diagonal-stripes-gap: 0.5rem;
    --diagonal-stripes-opacity: 0.03;

    --top-bar-link-color: var(--basalt-overtone);
 
    --UI-title-color: var(--basalt-main-text-color);
    --UI-title-background-color: var(--basalt-secondary-color);

    --hr-gradient: linear-gradient(var(--header-gradient-rotation), rgb(var(--hr-color-one), 0.75) 0%, rgb(var(--hr-color-two)) 100%);
    --hr-color-one: var(--basalt-main-text-color);
    --hr-color-two: var(--basalt-main-text-color);
}

#page-content img.image {
    filter: invert(0) hue-rotate(0deg) saturate(1);
    transition: filter ease 0.15s;
}

:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(5)) #page-content img.image,
:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(6)) #page-content img.image,
:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(7)) #page-content img.image {
    filter: invert(1) hue-rotate(180deg) saturate(10);
}

:where(#page-content .table) tt {
    padding: 0 0.25em;
    border-radius: 0.25em;
    background-color: rgb(var(--basalt-secondary-color));
}

:where(#page-content .table) tr > :nth-child(1) {
    width: 10%;
    white-space: nowrap;
}

.widgets li > tt:nth-child(1) {
    font-weight: bold;
    margin-right: 1em;
}

.grid-3 {
    margin: -1rem 0;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    text-align: center;
}

div#main-content div.grid-3.wide-content {
    max-width: calc(100dvw - 2 * var(--main-content-side-margin));
}

.grid-3 div.document,
.grid-3 div.lightdocument,
.grid-3 div.darkdocument {
    margin: 1.25rem 0;
}

@media (max-width: 512px) {
    .grid-3 {
        display: block;
        margin: 0;
    }
}

.block-example {
    text-align: center;
}
