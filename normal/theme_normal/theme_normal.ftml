[[iftags +版式]]

[[module CSS]]
@import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=design_services");
@import url('https://fonts.googleapis.com/css2?family=Google+Sans:wght@700&display=swap');
@import url("https://hormress.github.io/Parallel/branch/normal_projection/widget_layout_plus.css");

:where(#page-content) h1[id*="toc"]:not(#toc0) {
    margin-top: 6.5rem;
}

.preset .yui-navset.yui-navset-top > ul.yui-nav li,
.preset .yui-navset > ul.yui-nav li {
    flex-basis: 0%;
    white-space: nowrap;
}

.preset .yui-navset.yui-navset-top > ul.yui-nav li a,
.preset .yui-navset > ul.yui-nav li a {
    padding-inline: 0.5em;
}

.preset .yui-navset > ul.yui-nav li a em {
    display: block;
    margin: 0 auto;
    padding: 0 1.5em;
    width: max-content;
    height: 1.8em;
    align-content: center;
    border-radius: 0.9em;
    border: solid var(--thin-border-width) rgb(var(--basalt-secondary-color));
    transition: border-color ease 0.125s;
}

.preset .yui-navset > ul.yui-nav li.selected a em {
    border-color: rgb(var(--basalt-overtone));
}

.preset .yui-navset > ul.yui-nav li:nth-child(1) a em {
    color: rgb(188, 30, 20);
    background-color: rgb(239, 239, 240);
}

.preset .yui-navset > ul.yui-nav li:nth-child(2) a em {
    color: rgb(20, 20, 20);
    background-color: rgb(254, 254, 254);
}

.preset .yui-navset > ul.yui-nav li:nth-child(3) a em {
    color: rgb(184, 71, 61);
    background-color: rgb(218, 219, 222);
}

.preset .yui-navset > ul.yui-nav li:nth-child(4) a em {
    color: rgb(66, 66, 72);
    background-color: rgb(198, 199, 207);
}

.preset .yui-navset > ul.yui-nav li:nth-child(5) a em {
    color: rgb(252, 78, 78);
    background-color: rgb(48, 48, 50);
}

.preset .yui-navset > ul.yui-nav li:nth-child(6) a em {
    color: rgb(202, 202, 202);
    background-color: rgb(71, 54, 130);
}

.preset .yui-navset > ul.yui-nav li:nth-child(7) a em {
    color: rgb(254, 104, 104);
    background-color: rgb(10, 10, 12);
}

.preset .yui-navset.yui-navset-top > ul.yui-nav li a em::before,
.preset .yui-navset > ul.yui-nav li a em::before {
    display: none;
}

:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(2)) {
    --logo: url("https://hormress.github.io/SCP/image/logo/main/black.svg");

    --basalt-primary-color: 254, 254, 254;
    --basalt-secondary-color: 241, 242, 244;
    --basalt-tertiary-color: 218, 219, 222;
    --basalt-main-text-color: 20, 20, 20;
    --basalt-overtone: 50, 50, 50;
    --basalt-undertone: 61, 71, 202;
 
    --basalt-bright-element-color: 16, 76, 184;
    --basalt-dark-element-color: 18, 20, 150;
    --basalt-darker-element-color: 8, 10, 60;
    --basalt-alternate-color: 255, 132, 0;
    --basalt-positive-color: 24, 163, 20;
    --basalt-negative-color: 255, 48, 48;
    --basalt-sub-text-color: 155, 154, 162;

    --header-title-color: var(--basalt-main-text-color);
    --header-subtitle-color: var(--basalt-main-text-color);
    --header-color-one: var(--basalt-secondary-color);
    --header-color-two: var(--basalt-primary-color);
    --top-bar-link-color: var(--basalt-main-text-color);
    --UI-title-color: var(--basalt-main-text-color);

    --side-bar-button-color-hover: var(--basalt-light-text-color);
    --search-icon-color-hover: var(--basalt-light-text-color);
    --user-icon-button-color-hover: var(--basalt-light-text-color);

    --hr-gradient: linear-gradient(var(--header-gradient-rotation), rgb(var(--hr-color-one), 0.75) 0%, rgb(var(--hr-color-two)) 100%);
    --hr-color-one: var(--basalt-undertone);
    --hr-color-two: var(--basalt-undertone);
}

:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(3)) {
    --logo: url("https://hormress.github.io/SCP/image/logo/main/white.svg");

    --basalt-primary-color: 254, 254, 254;
    --basalt-secondary-color: 241, 242, 244;
    --basalt-tertiary-color: 218, 219, 222;
    --basalt-main-text-color: 20, 20, 20;
    --basalt-overtone: 20, 20, 20;
    --basalt-undertone: 184, 71, 61;
 
    --basalt-bright-element-color: 174, 76, 16;
    --basalt-dark-element-color: 150, 20, 18;
    --basalt-darker-element-color: 60, 10, 8;
    --basalt-alternate-color: 255, 132, 0;
    --basalt-positive-color: 24, 163, 20;
    --basalt-negative-color: 255, 48, 48;
    --basalt-sub-text-color: 155, 154, 162;

    --header-title-color: var(--basalt-light-text-color);
    --header-subtitle-color: var(--basalt-light-text-color);
    --header-color-one: var(--basalt-dark-element-color);
    --header-color-two: var(--basalt-darker-element-color);
    --top-bar-link-color: var(--basalt-light-text-color);
    --UI-title-color: var(--basalt-light-text-color);

    --side-bar-button-color-hover: var(--basalt-light-text-color);
    --search-icon-color-hover: var(--basalt-light-text-color);
    --user-icon-button-color-hover: var(--basalt-light-text-color);

    --hr-gradient: var(--header-gradient);
    --hr-color-one: var(--header-color-one);
    --hr-color-two: var(--header-color-two);
}

:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(4)) {
    --logo: url("https://hormress.github.io/SCP/image/logo/main/white.svg");

    --basalt-primary-color: 254, 254, 254;
    --basalt-secondary-color: 227, 228, 234;
    --basalt-tertiary-color: 198, 199, 207;
    --basalt-main-text-color: 20, 20, 20;
    --basalt-overtone: 20, 20, 20;
    --basalt-undertone: 57, 114, 164;
 
    --basalt-bright-element-color: 16, 104, 144;
    --basalt-dark-element-color: 66, 66, 72;
    --basalt-darker-element-color: 44, 44, 48;
    --basalt-alternate-color: 255, 132, 0;
    --basalt-positive-color: 24, 163, 20;
    --basalt-negative-color: 255, 48, 48;
    --basalt-sub-text-color: 155, 154, 162;

    --header-title-color: var(--basalt-light-text-color);
    --header-subtitle-color: var(--basalt-light-text-color);
    --header-color-one: var(--basalt-dark-element-color);
    --header-color-two: var(--basalt-darker-element-color);
    --top-bar-link-color: var(--basalt-light-text-color);
