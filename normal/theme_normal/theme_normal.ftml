    --diagonal-stripes-width: 0.5rem;
    --diagonal-stripes-gap: 0.75rem;
    --diagonal-stripes-opacity: 0.04;

    --hr-gradient: var(--header-gradient);
    --hr-color-one: var(--header-color-one);
    --hr-color-two: var(--header-color-two);
}

:root:has(.preset .yui-navset > ul.yui-nav li.selected:nth-child(5)) {
    --logo: url("https://hormress.github.io/SCP/image/logo/main/white.svg");

    --basalt-primary-color: 29, 28, 32;
    --basalt-secondary-color: 66, 66, 69;
    --basalt-tertiary-color: 78, 78, 80;
    --basalt-main-text-color: 254, 254, 254;
    --basalt-overtone: 254, 254, 254;
    --basalt-undertone: 232, 20, 20;
 
